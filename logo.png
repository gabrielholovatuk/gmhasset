/* ── Reset & Custom Properties ─────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --bg:          #111827;
  --bg-card:     #1f2937;
  --bg-sidebar:  #111827;
  --bg-input:    #374151;
  --border:      #374151;
  --border-focus:#60a5fa;
  --text:        #f1f5f9;
  --muted:       #9ca3af;
  --primary:     #60a5fa;
  --primary-dk:  #3b82f6;
  --green:       #34d399;
  --red:         #f87171;
  --amber:       #fbbf24;
  --pink:        #f472b6;
  --sidebar-w:   240px;
  --header-h:    56px;
  --radius:      10px;
  --shadow:      0 4px 24px rgba(0,0,0,.45);
}

html { scroll-behavior: smooth; }

body {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  background: var(--bg);
  color: var(--text);
  font-size: 14px;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

.hidden { display: none !important; }

/* ── Scrollbar ──────────────────────────────────────────────── */
::-webkit-scrollbar { width: 6px; height: 6px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }

/* ── Login Screen ───────────────────────────────────────────── */
#screen-login {
  min-height: 100dvh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: radial-gradient(ellipse at 50% 0%, rgba(59,130,246,.18) 0%, transparent 70%), var(--bg);
  padding: 1.5rem;
}

.login-logo {
  width: clamp(100px, 30vw, 180px);
  border-radius: 16px;
  box-shadow: 0 0 40px rgba(52,211,153,.25), var(--shadow);
  margin-bottom: 2rem;
}

.login-box {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 2rem;
  width: 100%;
  max-width: 380px;
  box-shadow: var(--shadow);
}

.login-title {
  font-size: 1.3rem;
  font-weight: 700;
  text-align: center;
  margin-bottom: 0.25rem;
}

.login-sub {
  text-align: center;
  color: var(--muted);
  font-size: 0.82rem;
  margin-bottom: 1.75rem;
}

.field-group { margin-bottom: 1rem; }
.field-group label { display: block; font-size: 0.8rem; color: var(--muted); margin-bottom: 0.35rem; }
.field-group input {
  width: 100%;
  background: var(--bg-input);
  border: 1px solid var(--border);
  border-radius: 7px;
  color: var(--text);
  padding: 0.6rem 0.8rem;
  font-size: 0.92rem;
  outline: none;
  transition: border-color .2s;
}
.field-group input:focus { border-color: var(--border-focus); }

.login-error { color: var(--red); font-size: 0.82rem; margin-top: .5rem; min-height: 1.2em; text-align: center; }

/* ── App Shell ──────────────────────────────────────────────── */
#screen-app { display: flex; height: 100dvh; overflow: hidden; }

/* Sidebar */
#sidebar {
  width: var(--sidebar-w);
  min-width: var(--sidebar-w);
  background: var(--bg-sidebar);
  border-right: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  transition: transform .25s ease;
  z-index: 200;
}

.sidebar-logo-wrap {
  padding: 1.25rem 1rem;
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  gap: .75rem;
}

.sidebar-logo {
  width: 40px;
  height: 40px;
  border-radius: 8px;
  object-fit: contain;
  box-shadow: 0 0 12px rgba(52,211,153,.3);
}

.sidebar-brand { font-size: .9rem; font-weight: 700; line-height: 1.2; }
.sidebar-brand span { display: block; font-size: .72rem; color: var(--muted); font-weight: 400; }

#nav-links { flex: 1; padding: .75rem .5rem; overflow-y: auto; }

.nav-link {
  display: flex;
  align-items: center;
  gap: .65rem;
  padding: .6rem .75rem;
  border-radius: 7px;
  color: var(--muted);
  text-decoration: none;
  font-size: .86rem;
  transition: background .15s, color .15s;
  cursor: pointer;
  margin-bottom: 2px;
}
.nav-link:hover { background: rgba(255,255,255,.06); color: var(--text); }
.nav-link.active { background: rgba(96,165,250,.15); color: var(--primary); }
.nav-icon { font-size: 1rem; width: 1.3rem; text-align: center; }

.sidebar-footer {
  padding: .75rem 1rem;
  border-top: 1px solid var(--border);
  display: flex;
  align-items: center;
  gap: .65rem;
}
.user-avatar {
  width: 32px; height: 32px; border-radius: 50%;
  background: linear-gradient(135deg, var(--primary), var(--green));
  display: flex; align-items: center; justify-content: center;
  font-size: .78rem; font-weight: 700; color: #000; flex-shrink: 0;
}
.user-info { flex: 1; overflow: hidden; }
.user-name { font-size: .82rem; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.badge { font-size: .64rem; padding: .15rem .45rem; border-radius: 999px; font-weight: 700; }
.badge-admin   { background: rgba(251,191,36,.2); color: var(--amber); }
.badge-cliente { background: rgba(96,165,250,.2);  color: var(--primary); }

#btn-logout {
  background: none; border: none; color: var(--muted); cursor: pointer;
  padding: .25rem .4rem; border-radius: 5px; font-size: .8rem;
  transition: background .15s, color .15s;
}
#btn-logout:hover { background: rgba(255,255,255,.08); color: var(--text); }

/* Overlay (mobile) */
#sidebar-overlay {
  display: none;
  position: fixed; inset: 0;
  background: rgba(0,0,0,.55);
  z-index: 199;
  opacity: 0;
  transition: opacity .25s;
}

/* Main area */
#main-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* Top header bar */
#app-header {
  height: var(--header-h);
  background: var(--bg-card);
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  padding: 0 1.25rem;
  gap: .75rem;
  flex-shrink: 0;
}

#btn-menu {
  display: none;
  background: none; border: none; color: var(--text);
  font-size: 1.3rem; cursor: pointer; padding: .25rem .4rem;
  border-radius: 6px;
}
#btn-menu:hover { background: rgba(255,255,255,.08); }

.header-title { font-weight: 700; font-size: 1rem; }
.header-sub   { font-size: .75rem; color: var(--muted); margin-left: auto; }

/* Page content */
#page-content {
  flex: 1;
  overflow-y: auto;
  padding: 1.5rem;
}

/* ── Common Components ──────────────────────────────────────── */
.page-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 1.5rem;
  gap: 1rem;
  flex-wrap: wrap;
}
.page-title { font-size: 1.4rem; font-weight: 700; }
.page-sub   { font-size: .82rem; color: var(--muted); margin-top: .2rem; }

.btn-icon {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 8px;
  color: var(--text);
  padding: .5rem .75rem;
  cursor: pointer;
  font-size: 1.1rem;
  transition: background .15s, transform .15s;
}
.btn-icon:hover { background: rgba(255,255,255,.1); transform: rotate(30deg); }

.btn-primary {
  background: var(--primary-dk);
  border: none; border-radius: 8px;
  color: #fff; padding: .6rem 1.2rem;
  font-size: .88rem; font-weight: 600;
  cursor: pointer; transition: background .15s, opacity .15s;
}
.btn-primary:hover { background: var(--primary); }
.btn-primary:disabled { opacity: .5; cursor: not-allowed; }

.btn-danger-sm {
  background: rgba(248,113,113,.15);
  border: 1px solid rgba(248,113,113,.3);
  border-radius: 6px; color: var(--red);
  padding: .25rem .6rem; font-size: .78rem;
  cursor: pointer; transition: background .15s;
}
.btn-danger-sm:hover { background: rgba(248,113,113,.3); }

/* ── Benchmarks ─────────────────────────────────────────────── */
.benchmarks-row {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  gap: 1rem;
  margin-bottom: 1.75rem;
}
.benchmark-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 1rem 1.25rem;
}
.benchmark-label { font-size: .75rem; color: var(--muted); margin-bottom: .4rem; }
.benchmark-value { font-size: 1.15rem; font-weight: 700; }
.benchmark-sub   { font-size: .72rem; color: var(--muted); margin-top: .25rem; }

/* ── Currency / Crypto Cards ────────────────────────────────── */
.section-label {
  font-size: .78rem; font-weight: 700; letter-spacing: .08em;
  text-transform: uppercase; color: var(--muted);
  margin-bottom: .75rem;
}

.cards-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
  gap: 1rem;
}

.currency-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 1rem;
  transition: border-color .2s, transform .2s;
}
.currency-card:hover { border-color: var(--primary); transform: translateY(-2px); }

.currency-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: .6rem; }
.currency-code   { font-size: .9rem; font-weight: 700; }
.currency-name   { font-size: .72rem; color: var(--muted); }
.currency-price  { font-size: 1.1rem; font-weight: 700; margin-bottom: .35rem; }
.currency-change { font-size: .82rem; font-weight: 600; }
.currency-meta   { font-size: .72rem; color: var(--muted); margin-top: .3rem; }

.star-btn {
  background: none; border: none; cursor: pointer;
  color: var(--muted); font-size: 1.1rem;
  transition: color .15s, transform .15s;
  padding: .1rem;
  line-height: 1;
}
.star-btn:hover  { color: var(--amber); transform: scale(1.2); }
.star-btn.active { color: var(--amber); }

/* ── P&L Colors ─────────────────────────────────────────────── */
.pos     { color: var(--green); }
.neg     { color: var(--red); }
.primary { color: var(--primary); }
.amber   { color: var(--amber); }
.bold    { font-weight: 700; }
.mono    { font-family: "Menlo", "Fira Code", monospace; }
.text-muted   { color: var(--muted); }
.text-error   { color: var(--red); }
.text-success { color: var(--green); }

/* ── Summary Bar ────────────────────────────────────────────── */
.summary-bar {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  gap: 1rem;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 1.25rem;
  margin-bottom: 1.5rem;
}
.summary-label { font-size: .75rem; color: var(--muted); }
.summary-value { font-size: 1.1rem; font-weight: 700; margin-top: .25rem; }
.summary-sub   { font-size: .82rem; font-weight: 600; margin-top: .15rem; }

/* ── Portfolio Card ─────────────────────────────────────────── */
.portfolio-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 1.25rem;
  margin-bottom: 1.25rem;
}
.portfolio-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem; flex-wrap: wrap; gap: .75rem; }
.portfolio-title-row { display: flex; align-items: center; gap: .75rem; }
.portfolio-dot  { width: 12px; height: 12px; border-radius: 50%; flex-shrink: 0; }
.portfolio-name { font-size: 1rem; font-weight: 700; }
.portfolio-meta { font-size: .73rem; color: var(--muted); margin-top: .15rem; }
.portfolio-pnl  { text-align: right; }
.pnl-pct { font-size: 1.1rem; font-weight: 700; }
.pnl-brl { font-size: .82rem; font-weight: 600; }

.portfolio-values {
  display: flex;
  align-items: center;
  gap: 1rem;
  flex-wrap: wrap;
  background: rgba(255,255,255,.03);
  border-radius: 8px;
  padding: .85rem 1rem;
  margin-bottom: 1.25rem;
}
.val-block { flex: 1; min-width: 120px; }
.val-label { font-size: .72rem; color: var(--muted); }
.val-main  { font-size: 1rem; font-weight: 700; margin-top: .15rem; }
.val-sub   { font-size: .78rem; color: var(--muted); }
.val-arrow { font-size: 1.4rem; color: var(--muted); }

/* ── Tables ─────────────────────────────────────────────────── */
.table-wrap, .alerts-table-wrap { overflow-x: auto; }

.positions-table {
  width: 100%;
  border-collapse: collapse;
  font-size: .82rem;
  white-space: nowrap;
}
.positions-table th {
  text-align: left;
  color: var(--muted);
  font-weight: 600;
  font-size: .74rem;
  text-transform: uppercase;
  letter-spacing: .06em;
  padding: .55rem .75rem;
  border-bottom: 1px solid var(--border);
}
.positions-table td {
  padding: .55rem .75rem;
  border-bottom: 1px solid rgba(255,255,255,.04);
}
.positions-table tbody tr:hover { background: rgba(255,255,255,.03); }
.positions-table th.right,
.positions-table td.right { text-align: right; }

/* ── Cards generic ──────────────────────────────────────────── */
.card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 1.25rem;
  margin-bottom: 1.25rem;
}
.card-title { font-size: .9rem; font-weight: 700; margin-bottom: 1rem; }

/* ── Alert Form ─────────────────────────────────────────────── */
.form-card { }
.alert-form {
  display: flex;
  flex-wrap: wrap;
  gap: .75rem;
  align-items: flex-end;
}
.input-field {
  background: var(--bg-input);
  border: 1px solid var(--border);
  border-radius: 7px;
  color: var(--text);
  padding: .6rem .8rem;
  font-size: .88rem;
  outline: none;
  transition: border-color .2s;
  min-width: 0;
}
.input-field:focus { border-color: var(--border-focus); }
.input-label { display: block; font-size: .78rem; color: var(--muted); margin-bottom: .35rem; }

/* ── Spinner ─────────────────────────────────────────────────── */
.spinner {
  width: 36px; height: 36px;
  border: 3px solid rgba(255,255,255,.1);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin .8s linear infinite;
  margin: 2.5rem auto;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* ── Error & Empty ──────────────────────────────────────────── */
.error-box {
  background: rgba(248,113,113,.1);
  border: 1px solid rgba(248,113,113,.3);
  border-radius: 8px;
  padding: 1rem 1.25rem;
  color: var(--red);
  font-size: .88rem;
}
.empty-state {
  text-align: center;
  padding: 4rem 1rem;
  color: var(--muted);
}
.empty-icon { font-size: 2.5rem; margin-bottom: 1rem; }

/* ── Report ──────────────────────────────────────────────────── */
.report-controls {
  display: flex;
  gap: 1.5rem;
  align-items: flex-end;
  flex-wrap: wrap;
}
.month-picker-wrap { min-width: 180px; }

.report-doc {
  background: #0f1729;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  overflow: hidden;
  font-size: 13px;
}

.report-cover {
  background: linear-gradient(135deg, #0f1729 0%, #1a2a45 50%, #0f2035 100%);
  padding: 3.5rem 2rem;
  text-align: center;
  position: relative;
  border-bottom: 1px solid var(--border);
}
.report-logo { width: 90px; border-radius: 12px; margin-bottom: 1.5rem; box-shadow: 0 0 30px rgba(52,211,153,.3); }
.report-cover-title { font-size: 1.8rem; font-weight: 800; }
.report-cover-sub { color: var(--primary); font-size: 1rem; margin-top: .5rem; }

.report-body { padding: 2rem; }
.report-section-title {
  font-size: .72rem; font-weight: 700; letter-spacing: .1em;
  text-transform: uppercase; color: var(--primary);
  border-bottom: 1px solid var(--border); padding-bottom: .5rem;
  margin-bottom: 1.25rem;
}

.report-summary-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
  gap: 1rem;
  margin-bottom: 1rem;
}
.report-stat {
  background: rgba(255,255,255,.04);
  border-radius: 8px; padding: .85rem 1rem;
  border: 1px solid var(--border);
}
.rs-label { font-size: .7rem; color: var(--muted); }
.rs-value { font-size: 1rem; font-weight: 700; margin-top: .3rem; }
.rs-sub   { font-size: .75rem; margin-top: .2rem; color: var(--muted); }

.report-portfolio {
  background: rgba(255,255,255,.03);
  border: 1px solid var(--border);
  border-radius: 8px; padding: 1rem;
  margin-bottom: 1rem;
}
.rp-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: .75rem; }
.rp-title  { display: flex; align-items: center; gap: .6rem; font-weight: 700; }
.rp-dot    { width: 10px; height: 10px; border-radius: 50%; }
.rp-pct    { font-size: .95rem; font-weight: 700; text-align: right; }
.rp-brl    { font-size: .78rem; font-weight: 600; text-align: right; }

.rp-values { display: flex; align-items: center; gap: 1rem; margin-bottom: .5rem; }
.rv-label { font-size: .7rem; color: var(--muted); }
.rv-val   { font-size: .9rem; font-weight: 700; }
.rv-sub   { font-size: .72rem; color: var(--muted); }
.rv-arrow { color: var(--muted); font-size: 1.2rem; }

.report-footer {
  display: flex;
  justify-content: space-between;
  font-size: .72rem;
  color: var(--muted);
  border-top: 1px solid var(--border);
  padding-top: 1rem;
  margin-top: 2rem;
  flex-wrap: wrap;
  gap: .5rem;
}
.report-disclaimer {
  font-size: .7rem; color: var(--muted);
  margin-top: .5rem; line-height: 1.5;
}

/* ── Responsive ─────────────────────────────────────────────── */
@media (max-width: 768px) {
  :root { --header-h: 52px; }

  #sidebar {
    position: fixed;
    top: 0; left: 0; bottom: 0;
    transform: translateX(-100%);
  }
  #sidebar.open { transform: translateX(0); }
  #sidebar-overlay { display: block; }
  #sidebar-overlay.visible { opacity: 1; pointer-events: auto; }

  #btn-menu { display: flex; }

  #page-content { padding: 1rem; }

  .cards-grid { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: .75rem; }

  .benchmarks-row { grid-template-columns: repeat(3, 1fr); gap: .65rem; }
  .benchmark-card { padding: .75rem; }
  .benchmark-value { font-size: 1rem; }

  .positions-table { font-size: .78rem; }
  .positions-table th, .positions-table td { padding: .45rem .55rem; }

  .portfolio-values { gap: .5rem; }
  .val-arrow { display: none; }

  .report-summary-grid { grid-template-columns: repeat(2, 1fr); }
  .report-cover { padding: 2rem 1rem; }
  .report-body  { padding: 1.25rem; }

  .alert-form { flex-direction: column; }
  .alert-form .input-field { width: 100%; }
  .alert-form .btn-primary { width: 100%; }

  .page-header { flex-direction: column; gap: .75rem; }
}

@media (max-width: 480px) {
  .benchmarks-row { grid-template-columns: 1fr; }
  .cards-grid { grid-template-columns: 1fr 1fr; }
  .report-summary-grid { grid-template-columns: 1fr; }
}
